# ── الوضع التجريبي (الافتراضي) ─────────────────────────────
# إذا لم يوجد ملف .env أصلاً، يعمل النظام ببيانات وهمية داخل المتصفح.
# لإجبار الوضع التجريبي حتى مع وجود إعدادات Supabase:
# VITE_DEMO=true

# ── الوضع الحقيقي: Supabase ────────────────────────────────
# محلياً: شغّل `supabase start` وانسخ القيم من الطرفية.
# على GitHub Pages: ضع القيمتين في Settings > Secrets and variables > Actions
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=ضع_مفتاح_anon_هنا

# ── النشر على GitHub Pages ─────────────────────────────────
# موقع مشروع: https://<user>.github.io/<repo>/  →  /<repo>/
# نطاق مخصّص أو موقع مستخدم                     →  اتركه فارغاً
# (يضبطه سكربت GitHub Actions تلقائياً، هذا للبناء المحلي فقط)
# VITE_BASE_PATH=/waqf-trpolr/
